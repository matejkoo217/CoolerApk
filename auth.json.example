{
  "_readme": [
    "Optional Coolapk credentials for the reply/comment fetch. Copy to auth.json (NOT tracked by git).",
    "device       - replaces the shared default device fingerprint (fixes the -415 'too many accounts on this device' flag).",
    "login_token  - account token from a logged-in Coolapk session; sent as ?token= (plus uid) on reply requests.",
    "uid          - account uid that goes with login_token.",
    "Any key may be omitted; the file is re-read at most once a minute, no restart needed."
  ],
  "device": "",
  "login_token": "",
  "uid": ""
}
